<div class="panel" id="panel-absence">
  <div class="page-header">
    <div class="page-title">Data Kehadiran</div>
    <div class="page-desc">Rekap absensi seluruh siswa</div>
  </div>

  <div class="stats-grid">
    <div class="stat-card green">
      <div class="stat-label">Hadir Hari Ini</div>
      <div class="stat-value">233</div>
      <div class="stat-change">
        <span class="up">94%</span> dari total siswa
      </div>
      <div class="stat-icon">✅</div>
    </div>
    <div class="stat-card amber">
      <div class="stat-label">Izin</div>
      <div class="stat-value">10</div>
      <div class="stat-change">4% siswa</div>
      <div class="stat-icon">📄</div>
    </div>
    <div class="stat-card blue">
      <div class="stat-label">Sakit</div>
      <div class="stat-value">3</div>
      <div class="stat-change">1.2% siswa</div>
      <div class="stat-icon">🏥</div>
    </div>
    <div class="stat-card" style="border-color: var(--red)">
      <div class="stat-label">Alpha</div>
      <div class="stat-value" style="color: var(--red)">2</div>
      <div class="stat-change">0.8% siswa</div>
      <div class="stat-icon">❌</div>
    </div>
  </div>

  <div class="actions-row">
    <select class="filter-select">
      <option>Semua Kelas</option>
      <option>Kelas X</option>
      <option>Kelas XI</option>
      <option>Kelas XII</option>
    </select>
    <select class="filter-select">
      <option>Hari Ini</option>
      <option>Minggu Ini</option>
      <option>Bulan Ini</option>
    </select>
    <div style="flex: 1"></div>
    <button class="btn btn-primary">+ Tambah Absen</button>
  </div>

  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>#</th>
          <th>Nama Siswa</th>
          <th>Kelas</th>
          <th>Tanggal</th>
          <th>Status</th>
          <th>Keterangan</th>
          <th>Aksi</th>
        </tr>
      </thead>
      <tbody id="absence-tbody"></tbody>
    </table>
  </div>
</div>
