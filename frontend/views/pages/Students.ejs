        <div class="panel" id="panel-student">
          <div class="page-header">
            <div class="page-title">Data Siswa</div>
            <div class="page-desc">248 siswa terdaftar</div>
          </div>

          <div class="actions-row">
            <select class="filter-select" id="filter-classLevel-student">
              <option value="all">Semua Kelas</option>
            </select>
            <select class="filter-select" id="filter-status-student">
              <option value="all">Semua Status</option>
              <option value="aktif">Aktif</option>
              <option value="pkl">PKL</option>
              <option value="pindah">Pindah</option>
              <option value="lulus">Lulus</option>
            </select>
            <div style="flex: 1"></div>
            <button class="btn btn-primary" id="btn-filter-student">
              Filter Siswa
            </button>
            <button class="btn btn-primary">+ Tambah Siswa</button>
          </div>

          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>NIS</th>
                  <th>Nama Siswa</th>
                  <th>Kelas</th>
                  <th>NISN</th>
                  <th>Wali Kelas</th>
                  <th>Status</th>
                  <th>Aksi</th>
                </tr>
              </thead>
              <tbody id="student-tbody"></tbody>
            </table>
          </div>
        </div>
