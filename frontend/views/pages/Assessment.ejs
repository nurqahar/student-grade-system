
        <div class="panel" id="panel-assessment">
          <div class="page-header">
            <div class="page-title">Penilaian & Ujian</div>
            <div class="page-desc">Kelola nilai</div>
          </div>

          <div class="actions-row">
            <select class="filter-select" id="filter-classLevel-assessment">
              <option value="all">Semua Kelas</option>
            </select>
            <select class="filter-select" id="filter-subject-assessment">
              <option value="all">Semua Mapel</option>
            </select>
            <select class="filter-select" id="filter-year-assessment">
              <option value="all">Semua Tahun Pelajaran</option>
            </select>
            <select class="filter-select" id="filter-semester-assessment">
              <option value="all">Semua Semester</option>
            </select>
            <div style="flex: 1"></div>
            <button class="btn btn-primary" id="btn-filter-assessment">
              Apply Filter
            </button>
            <button class="btn btn-primary">+ Tambah Nilai</button>
          </div>

          <div class="table-wrap">
            <table id="assessment-table">
              <thead>
                <tr>
                  <th>#</th>
                  <th>NIS</th>
                  <th>Siswa</th>
                  <th>Kelas</th>
                  <th>Mata Pelajaran</th>
                  <th>Nilai Akhir</th>
                  <th>Nilai Huruf</th>
                </tr>
              </thead>
              <tbody id="assessment-tbody"></tbody>
            </table>
          </div>
        </div>
