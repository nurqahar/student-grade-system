<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>EduCore — School Management Dashboard</title>
    <link
      href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;1,9..40,300&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <!-- SIDEBAR -->
    <aside class="sidebar" id="sidebar">
      <div class="sidebar-logo">
        <div class="logo-icon">🎓</div>
        <div class="logo-text">Edu<span>Core</span></div>
      </div>

      <nav class="sidebar-nav">
        <div class="nav-section-label">Overview</div>
        <button class="nav-item active" data-panel="dashboard">
          <span class="nav-icon">🏠</span> Dashboard
        </button>

        <div class="nav-section-label">Settings</div>
        <button class="nav-item" data-panel="setting">
          <span class="nav-icon">⚙️</span> Pengaturan
        </button>

        <div class="nav-section-label">Academic</div>
        <button class="nav-item" data-panel="rapor">
          <span class="nav-icon">📄</span> Rapor
        </button>
        <button class="nav-item" data-panel="absence">
          <span class="nav-icon">📋</span> Absence
          <span class="badge amber">12</span>
        </button>
        <button class="nav-item" data-panel="assessment">
          <span class="nav-icon">📝</span> Assessment
        </button>
        <button class="nav-item" data-panel="subject">
          <span class="nav-icon">📚</span> Subjects
        </button>
        <button class="nav-item" data-panel="classes">
          <span class="nav-icon">🏫</span> Classes
        </button>
        <button class="nav-item" data-panel="level">
          <span class="nav-icon">🏅</span> Levels
        </button>

        <div class="nav-section-label">People</div>
        <button class="nav-item" data-panel="student">
          <span class="nav-icon">🧑‍🎓</span> Students
          <span class="badge green" id="badge-students">248</span>
        </button>
        <button class="nav-item" data-panel="teacher">
          <span class="nav-icon">🧑‍🏫</span> Teachers
        </button>

        <div class="nav-section-label">Reports</div>
        <button class="nav-item" data-panel="history">
          <span class="nav-icon">🕰️</span> History
        </button>
      </nav>

      <div class="sidebar-footer">
        <div class="user-card">
          <div class="avatar">AD</div>
          <div class="user-info">
            <div class="user-name">Admin Sekolah</div>
            <div class="user-role">Administrator</div>
          </div>
          <span style="color: var(--muted); font-size: 14px">⚙️</span>
        </div>
      </div>
    </aside>

    <div class="overlay" id="overlay"></div>

    <!-- MAIN -->
    <main class="main">
      <header class="topbar">
        <div class="hamburger" id="hamburger">☰</div>
        <div>
          <div class="topbar-title" id="topbar-title">Dashboard</div>
          <div class="topbar-subtitle" id="topbar-subtitle">
            Selamat datang, Admin Sekolah
          </div>
        </div>
        <div class="topbar-spacer"></div>
        <div class="topbar-spacer"></div>
        <div class="main-setting">
          <select class="setting-year">
            <option value="">Pilih Tahun</option>
          </select>
        </div>
        <div class="topbar-spacer"></div>
        <div class="search-box">
          <span style="color: var(--muted); font-size: 14px">🔍</span>
          <input type="text" placeholder="Cari sesuatu..." />
        </div>
        <div class="icon-btn">
          🔔
          <div class="notif-dot"></div>
        </div>
        <div class="icon-btn">📅</div>
      </header>

      <div class="content">
        <!-- ════════════════════════════════
         DASHBOARD PANEL
    ════════════════════════════════ -->
        <div class="panel active" id="panel-dashboard">
          <div class="page-header">
            <div class="page-title">Overview Sekolah</div>
            <div class="page-desc">
              Tahun ajaran 2025 / 2026 — Semester Genap
            </div>
          </div>

          <div class="stats-grid">
            <div class="stat-card blue">
              <div class="stat-label">Total Siswa</div>
              <div class="stat-value">248</div>
              <div class="stat-change">
                <span class="up">↑ 12</span> dari semester lalu
              </div>
              <div class="stat-icon">🧑‍🎓</div>
            </div>
            <div class="stat-card purple">
              <div class="stat-label">Total Guru</div>
              <div class="stat-value">32</div>
              <div class="stat-change">
                <span class="up">↑ 2</span> guru baru
              </div>
              <div class="stat-icon">🧑‍🏫</div>
            </div>
            <div class="stat-card green">
              <div class="stat-label">Kehadiran Hari Ini</div>
              <div class="stat-value">94%</div>
              <div class="stat-change">
                <span class="up">↑ 3%</span> dari kemarin
              </div>
              <div class="stat-icon">✅</div>
            </div>
            <div class="stat-card amber">
              <div class="stat-label">Nilai Rata-rata</div>
              <div class="stat-value">81.4</div>
              <div class="stat-change">
                <span class="down">↓ 0.6</span> dari ujian lalu
              </div>
              <div class="stat-icon">📊</div>
            </div>
          </div>

          <div class="charts-row">
            <!-- bar chart -->
            <div class="chart-card">
              <div class="chart-title">Kehadiran Mingguan (%)</div>
              <div class="bar-chart">
                <div class="bar-col">
                  <div
                    class="bar"
                    style="
                      height: 88%;
                      background: linear-gradient(
                        180deg,
                        var(--accent),
                        var(--accent2)
                      );
                    "
                  ></div>
                  <div class="bar-label">Sen</div>
                </div>
                <div class="bar-col">
                  <div
                    class="bar"
                    style="
                      height: 95%;
                      background: linear-gradient(
                        180deg,
                        var(--accent),
                        var(--accent2)
                      );
                    "
                  ></div>
                  <div class="bar-label">Sel</div>
                </div>
                <div class="bar-col">
                  <div
                    class="bar"
                    style="
                      height: 91%;
                      background: linear-gradient(
                        180deg,
                        var(--accent),
                        var(--accent2)
                      );
                    "
                  ></div>
                  <div class="bar-label">Rab</div>
                </div>
                <div class="bar-col">
                  <div
                    class="bar"
                    style="
                      height: 78%;
                      background: linear-gradient(
                        180deg,
                        var(--accent),
                        var(--accent2)
                      );
                    "
                  ></div>
                  <div class="bar-label">Kam</div>
                </div>
                <div class="bar-col">
                  <div
                    class="bar"
                    style="
                      height: 85%;
                      background: linear-gradient(
                        180deg,
                        var(--accent),
                        var(--accent2)
                      );
                    "
                  ></div>
                  <div class="bar-label">Jum</div>
                </div>
                <div class="bar-col">
                  <div
                    class="bar"
                    style="
                      height: 60%;
                      background: linear-gradient(
                        180deg,
                        var(--green),
                        #16a37a
                      );
                    "
                  ></div>
                  <div class="bar-label">Sab</div>
                </div>
              </div>
            </div>

            <!-- donut chart -->
            <div
              class="chart-card"
              style="display: flex; flex-direction: column; align-items: center"
            >
              <div class="chart-title" style="width: 100%">
                Status Kehadiran
              </div>
              <div class="donut-wrap">
                <svg width="130" height="130" viewBox="0 0 130 130">
                  <circle
                    cx="65"
                    cy="65"
                    r="52"
                    fill="none"
                    stroke="var(--bg4)"
                    stroke-width="14"
                  />
                  <!-- hadir 94% = 326.4 of 326.9 -->
                  <circle
                    cx="65"
                    cy="65"
                    r="52"
                    fill="none"
                    stroke="var(--green)"
                    stroke-width="14"
                    stroke-dasharray="306.1 326.9"
                    stroke-dashoffset="0"
                  />
                  <!-- izin 4% -->
                  <circle
                    cx="65"
                    cy="65"
                    r="52"
                    fill="none"
                    stroke="var(--amber)"
                    stroke-width="14"
                    stroke-dasharray="13.1 326.9"
                    stroke-dashoffset="-306.1"
                  />
                  <!-- alpha 2% -->
                  <circle
                    cx="65"
                    cy="65"
                    r="52"
                    fill="none"
                    stroke="var(--red)"
                    stroke-width="14"
                    stroke-dasharray="6.5 326.9"
                    stroke-dashoffset="-319.2"
                  />
                </svg>
                <div class="donut-center">
                  <div class="donut-num">94%</div>
                  <div class="donut-sub">Hadir</div>
                </div>
              </div>
              <div class="donut-legend" style="width: 100%">
                <div class="legend-item">
                  <div
                    class="legend-dot"
                    style="background: var(--green)"
                  ></div>
                  Hadir <span class="legend-val">94%</span>
                </div>
                <div class="legend-item">
                  <div
                    class="legend-dot"
                    style="background: var(--amber)"
                  ></div>
                  Izin <span class="legend-val">4%</span>
                </div>
                <div class="legend-item">
                  <div class="legend-dot" style="background: var(--red)"></div>
                  Alpha <span class="legend-val">2%</span>
                </div>
              </div>
            </div>
          </div>

          <!-- recent activity -->
          <div class="section-header">
            <div class="section-title">Aktivitas Terbaru</div>
            <button class="btn btn-ghost">Lihat semua</button>
          </div>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Nama</th>
                  <th>Kelas</th>
                  <th>Aktivitas</th>
                  <th>Waktu</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td class="td-name">
                    <div
                      class="mini-avatar"
                      style="
                        background: linear-gradient(
                          135deg,
                          var(--accent),
                          var(--accent2)
                        );
                      "
                    >
                      AR
                    </div>
                    Ahmad Rafi
                  </td>
                  <td>X-A</td>
                  <td>Ujian Matematika</td>
                  <td>10:30</td>
                  <td><span class="pill pill-green">Lulus</span></td>
                </tr>
                <tr>
                  <td class="td-name">
                    <div
                      class="mini-avatar"
                      style="
                        background: linear-gradient(
                          135deg,
                          var(--green),
                          #16a37a
                        );
                      "
                    >
                      SR
                    </div>
                    Siti Rahma
                  </td>
                  <td>XI-B</td>
                  <td>Absen Masuk</td>
                  <td>07:12</td>
                  <td><span class="pill pill-blue">Hadir</span></td>
                </tr>
                <tr>
                  <td class="td-name">
                    <div
                      class="mini-avatar"
                      style="
                        background: linear-gradient(
                          135deg,
                          var(--amber),
                          #d97706
                        );
                      "
                    >
                      BL
                    </div>
                    Bima Laksono
                  </td>
                  <td>XII-C</td>
                  <td>Absen</td>
                  <td>08:00</td>
                  <td><span class="pill pill-amber">Izin</span></td>
                </tr>
                <tr>
                  <td class="td-name">
                    <div
                      class="mini-avatar"
                      style="
                        background: linear-gradient(
                          135deg,
                          var(--accent2),
                          var(--cyan)
                        );
                      "
                    >
                      DW
                    </div>
                    Dewi Wulandari
                  </td>
                  <td>X-B</td>
                  <td>Nilai Fisika</td>
                  <td>09:45</td>
                  <td><span class="pill pill-green">92 / 100</span></td>
                </tr>
                <tr>
                  <td class="td-name">
                    <div
                      class="mini-avatar"
                      style="
                        background: linear-gradient(
                          135deg,
                          var(--red),
                          #c2185b
                        );
                      "
                    >
                      FR
                    </div>
                    Fajar Rizki
                  </td>
                  <td>XI-A</td>
                  <td>Absen</td>
                  <td>—</td>
                  <td><span class="pill pill-red">Alpha</span></td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
        <!-- ════════════════════════════════
         SETTING PANEL
    ════════════════════════════════ -->
        <%- include('pages/Setting') %>

        <!-- ════════════════════════════════
         RAPOR PANEL
    ════════════════════════════════ -->
        <%- include('pages/Rapor') %>

        <!-- ════════════════════════════════
         ABSENCE PANEL
    ════════════════════════════════ -->
        <%- include('pages/Absence') %>

        <!-- ════════════════════════════════
         ASSESSMENT PANEL
    ════════════════════════════════ -->
        <%- include('pages/Assessment') %>

        <!-- ════════════════════════════════
         STUDENTS PANEL
    ════════════════════════════════ -->
        <%- include('pages/Students') %>

        <!-- ════════════════════════════════
         TEACHER PANEL
    ════════════════════════════════ -->
        <%- include('pages/Teachers') %>

        <!-- ════════════════════════════════
         SUBJECT PANEL
    ════════════════════════════════ -->
        <%- include('pages/Subjects') %>

        <!-- ════════════════════════════════
         HISTORY PANEL
    ════════════════════════════════ -->
        <%- include('pages/History') %>

        <!-- ════════════════════════════════
         CLASSES PANEL
    ════════════════════════════════ -->
        <%- include('pages/Classes') %>

        <!-- ════════════════════════════════
         LEVEL PANEL
    ════════════════════════════════ -->
        <%- include('pages/Level') %>
      </div>
      <!-- /content -->
    </main>

    <script type="module" src="script.js"></script>
  </body>
</html>
